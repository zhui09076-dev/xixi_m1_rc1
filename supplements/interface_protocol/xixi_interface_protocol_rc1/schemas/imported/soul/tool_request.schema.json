{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xixi.local/schemas/imported/soul/tool_request.schema.json",
  "title": "XiXi Tool Request",
  "type": "object",
  "required": [
    "capability",
    "operation",
    "target",
    "input",
    "risk",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "capability": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": {
      "type": "object"
    },
    "risk": {
      "enum": [
        "ordinary",
        "scoped",
        "outbound_private",
        "irreversible"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
