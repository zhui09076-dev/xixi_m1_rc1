{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xixi.local/schemas/payloads/system.error.schema.json",
  "title": "system.error",
  "type": "object",
  "required": [
    "code",
    "message",
    "severity",
    "retryable"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "related_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "details": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
