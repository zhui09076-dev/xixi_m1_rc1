{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xixi.local/schemas/payloads/ui.mode.set.schema.json",
  "title": "ui.mode.set",
  "type": "object",
  "required": [
    "mode",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "quiet",
        "chat",
        "work",
        "permission"
      ]
    },
    "reason": {
      "type": "string"
    },
    "panel": {
      "type": [
        "string",
        "null"
      ]
    },
    "focus": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
