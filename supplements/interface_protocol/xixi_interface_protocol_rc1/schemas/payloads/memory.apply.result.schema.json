{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xixi.local/schemas/payloads/memory.apply.result.schema.json",
  "title": "memory.apply.result",
  "type": "object",
  "required": [
    "turn_id",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "turn_id": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "status",
          "record_id"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "applied",
              "rejected",
              "failed",
              "clarification_required"
            ]
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
